[
  {
    "seg": "くらいうみのなか、",
    "start": 0.015,
    "end": 1.258
  },
  {
    "seg": "さかさまのしせいでじっとぶらさがるとうめいないきもの。",
    "start": 1.258,
    "end": 4.652
  },
  {
    "seg": "くちはのさしわたしは2から4せんち。",
    "start": 4.652,
    "end": 7.235
  },
  {
    "seg": "このすがたでなにをしているのでしょうか。",
    "start": 7.235,
    "end": 9.615
  },
  {
    "seg": "これは、",
    "start": 9.615,
    "end": 10.257
  },
  {
    "seg": "せかいじゅうのふかいうみにすむくしくらげのなかまです。",
    "start": 10.257,
    "end": 13.644
  },
  {
    "seg": "ときにはくちはをはばたかせて、",
    "start": 13.644,
    "end": 15.612
  },
  {
    "seg": "うみのなかをおよぐこともできます。",
    "start": 15.612,
    "end": 17.92
  },
  {
    "seg": "しかしふだんはうごかず、",
    "start": 17.92,
    "end": 19.443
  },
  {
    "seg": "しずかにぶらさがったままです。",
    "start": 19.443,
    "end": 21.513
  },
  {
    "seg": "ひろげたくちはは、",
    "start": 21.513,
    "end": 22.739
  },
  {
    "seg": "ちかづいたえものをすっぽりととじこめるためのものです。",
    "start": 22.739,
    "end": 26.121
  },
  {
    "seg": "そしてとらえたえものを、",
    "start": 26.121,
    "end": 27.635
  },
  {
    "seg": "しょくしゅであかいちょうのなかへひきずりこみます。",
    "start": 27.635,
    "end": 30.514
  },
  {
    "seg": "えものをのみこんだとうめいなからだは、",
    "start": 30.514,
    "end": 32.733
  },
  {
    "seg": "ふたたびしずかにぶらさがります。",
    "start": 32.733,
    "end": 34.92
  }
]