[
  {
    "seg": "せんはっぴゃくななじゅうはちねん、",
    "start": 0.015,
    "end": 1.706
  },
  {
    "seg": "メキシコわん。",
    "start": 1.706,
    "end": 2.726
  },
  {
    "seg": "りょうしの あみに、",
    "start": 2.726,
    "end": 3.827
  },
  {
    "seg": "みたことの ない おおきな いきものが かかりました。",
    "start": 3.827,
    "end": 6.787
  },
  {
    "seg": "みためは ダンゴムシ。",
    "start": 6.787,
    "end": 8.349
  },
  {
    "seg": "でも じつは、",
    "start": 8.349,
    "end": 9.232
  },
  {
    "seg": "フナムシに ちかい なかまです。",
    "start": 9.232,
    "end": 11.0
  },
  {
    "seg": "おおきさは さいだい ごじゅっセンチ ちかく。",
    "start": 11.0,
    "end": 13.485
  },
  {
    "seg": "ダンゴムシの なかまでは、",
    "start": 13.485,
    "end": 14.936
  },
  {
    "seg": "せかいさいだいです。",
    "start": 14.936,
    "end": 16.219
  },
  {
    "seg": "そのなは、",
    "start": 16.219,
    "end": 16.994
  },
  {
    "seg": "ダイオウグソクムシ。",
    "start": 16.994,
    "end": 18.377
  },
  {
    "seg": "くろい めは、",
    "start": 18.377,
    "end": 19.273
  },
  {
    "seg": "やく さんぜんごひゃっこの ちいさな めの あつまりです。",
    "start": 19.273,
    "end": 22.62
  },
  {
    "seg": "ふかい うみの そこで、",
    "start": 22.62,
    "end": 23.903
  },
  {
    "seg": "しずんで きた クジラや さかなの しがいを たべる、",
    "start": 23.903,
    "end": 26.545
  },
  {
    "seg": "しんかいの そうじやです。",
    "start": 26.545,
    "end": 28.254
  },
  {
    "seg": "とばすいぞくかんで かわれて いた いっぴきは、",
    "start": 28.254,
    "end": 30.705
  },
  {
    "seg": "にせんきゅうねん、",
    "start": 30.705,
    "end": 31.759
  },
  {
    "seg": "エサの アジを たべたのを さいごに、",
    "start": 31.759,
    "end": 33.737
  },
  {
    "seg": "せんはっぴゃくろくじゅうきゅうにち、",
    "start": 33.737,
    "end": 35.506
  },
  {
    "seg": "ごねん いじょうも なにも たべませんでした。",
    "start": 35.506,
    "end": 38.003
  },
  {
    "seg": "しんだ あと、",
    "start": 38.003,
    "end": 38.903
  },
  {
    "seg": "いの なかは からっぽ。",
    "start": 38.903,
    "end": 40.278
  },
  {
    "seg": "りゆうは、",
    "start": 40.278,
    "end": 41.022
  },
  {
    "seg": "いまも わかって いません。",
    "start": 41.022,
    "end": 42.483
  }
]