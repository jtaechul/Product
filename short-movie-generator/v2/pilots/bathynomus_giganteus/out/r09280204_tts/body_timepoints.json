[
  {
    "seg": "せんはっぴゃくななじゅうはちねん、",
    "start": 0.015,
    "end": 1.706
  },
  {
    "seg": "メキシコわん。",
    "start": 1.706,
    "end": 2.726
  },
  {
    "seg": "りょうしの あみに、",
    "start": 2.726,
    "end": 3.827
  },
  {
    "seg": "みたことの ない おおきな いきものが かかりました。",
    "start": 3.827,
    "end": 6.787
  },
  {
    "seg": "みためは ダンゴムシ。",
    "start": 6.787,
    "end": 8.349
  },
  {
    "seg": "でも じつは、",
    "start": 8.349,
    "end": 9.232
  },
  {
    "seg": "フナムシに ちかい なかまです。",
    "start": 9.232,
    "end": 11.0
  },
  {
    "seg": "おおきさは さいだい ごじゅっセンチ ちかく。",
    "start": 11.0,
    "end": 13.485
  },
  {
    "seg": "とうあしるいの なかでは、",
    "start": 13.485,
    "end": 14.91
  },
  {
    "seg": "せかいさいだいです。",
    "start": 14.91,
    "end": 16.2
  },
  {
    "seg": "そのなは、",
    "start": 16.2,
    "end": 16.975
  },
  {
    "seg": "ダイオウグソクムシ。",
    "start": 16.975,
    "end": 18.358
  },
  {
    "seg": "くろい めは、",
    "start": 18.358,
    "end": 19.254
  },
  {
    "seg": "やく さんぜんごひゃっこの ちいさな めの あつまりです。",
    "start": 19.254,
    "end": 22.6
  },
  {
    "seg": "ふかい うみの そこで、",
    "start": 22.6,
    "end": 23.884
  },
  {
    "seg": "しずんで きた クジラや さかなの しがいを たべる、",
    "start": 23.884,
    "end": 26.526
  },
  {
    "seg": "しんかいの そうじやです。",
    "start": 26.526,
    "end": 28.235
  },
  {
    "seg": "とばすいぞくかんで かわれて いた いっぴきは、",
    "start": 28.235,
    "end": 30.686
  },
  {
    "seg": "にせんきゅうねん、",
    "start": 30.686,
    "end": 31.739
  },
  {
    "seg": "エサの アジを たべたのを さいごに、",
    "start": 31.739,
    "end": 33.718
  },
  {
    "seg": "せんはっぴゃくろくじゅうきゅうにち、",
    "start": 33.718,
    "end": 35.487
  },
  {
    "seg": "ごねん いじょうも なにも たべませんでした。",
    "start": 35.487,
    "end": 37.984
  },
  {
    "seg": "しんだ あと、",
    "start": 37.984,
    "end": 38.884
  },
  {
    "seg": "いの なかは からっぽ。",
    "start": 38.884,
    "end": 40.258
  },
  {
    "seg": "りゆうは、",
    "start": 40.258,
    "end": 41.003
  },
  {
    "seg": "いまも わかって いません。",
    "start": 41.003,
    "end": 42.464
  }
]