// 점프리시(Jumplish) Cloudflare Workers 설정
// - 정적 자산(public/)은 [assets] 바인딩으로 서빙, /api/* 는 worker(Hono)가 처리
// - D1: 로컬 개발은 placeholder id로 동작(wrangler --local), 원격 배포 시
//   deploy-jumplish.yml 워크플로가 실제 database_id로 치환한다
{
  "name": "jumplish",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // 매일 밤 2시(KST=17:00 UTC) — 부족한 문항을 서버가 스스로 주문한다(worker/index.mjs nightlyTopUp).
  // GitHub Actions 의 schedule 은 기본 브랜치(main)에 있는 워크플로만 돌리는데 점프리시 배치는
  // 작업 브랜치에만 살아서 쓸 수 없다. Cloudflare Cron 은 브랜치와 무관하다.
  "triggers": {
    "crons": ["0 17 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jumplish-db",
      "database_id": "REPLACED_AT_DEPLOY",
      "migrations_dir": "migrations"
    }
  ]
}
